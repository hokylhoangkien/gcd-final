{
  "method": "crish",
  "training_protocol": "crish_v2_1",
  "device": "cuda",
  "dino": "v2",
  "seed": 1,
  "epochs": 200,
  "batch_size": 128,
  "num_workers": 4,
  "grad_from_block": 10,
  "lr": 0.1,
  "weight_decay": 5e-05,
  "sup_con_weight": 0.35,
  "unsupervised_smoothing": 0.5,
  "hyper_max_weight": 0.5,
  "c": 0.1,
  "cr": 2.0,
  "mlp_out_dim": 8192,
  "prototype_extraction_interval": 1,
  "max_runtime_seconds": 86400,
  "checkpoint_selection": "best_old_test_v2",
  "align_cluster_rows": true,
  "test_every_epochs": 1,
  "plain_train_eval_every": 0,
  "final_ss_evaluation": true,
  "ss_eval_every_epochs": 0,
  "ss_eval_timeout_seconds": 1800,
  "evaluation_rng": "isolated",
  "max_steps_per_epoch": 0,
  "final_eval_timeout_seconds": 1800,
  "crish": {
    "enabled": true,
    "warmup_epochs": 10,
    "refresh_every": 5,
    "evidence_samples": 128,
    "evidence_trials": 2,
    "k": 5,
    "boundaries": 2,
    "max_targets": 1,
    "max_accepted": 1,
    "min_support": 2,
    "min_edges": 1,
    "min_reliability": 0.5,
    "train_batch": 32,
    "probe_known": 16,
    "probe_unlabeled": 32,
    "acceptance_gain": 0.0,
    "known_tolerance": 0.0,
    "max_protected_shift": 0.25,
    "max_refresh_seconds": 120,
    "stability_trials": 0,
    "save_partitions": true,
    "evidence_sampling": "global_neighbors",
    "neighbor_reference_block": 1024,
    "probe_sampling": "class_balanced"
